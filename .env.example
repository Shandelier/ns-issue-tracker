# Required: OpenRouter API key for estimations
OPENROUTER_API_KEY=or-...

# Required: password gate (SHA-256 digest of the access password)
APP_PASSWORD_SHA256=bdc398057a16edaab67ee1f361f9d59cc7f58c442364b1311590da49fb6fd2a9

# Optional: specify the OpenRouter model alias
# OPENROUTER_MODEL=x-ai/grok-code-fast-1

# Optional: identify your app when calling OpenRouter
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_TITLE=Issue Estimator

# Legacy fallback if you still use OpenAI directly
# OPENAI_API_KEY=sk-...

# Optional: increase GitHub rate limits
GITHUB_TOKEN=ghp_...

# Optional: override outbound API timeout (milliseconds)
# EXTERNAL_API_TIMEOUT_MS=20000

# Optional: verbose logging for GitHub/OpenRouter requests
# EXTERNAL_API_DEBUG=1

# Optional: capture OpenRouter payloads for debugging
# OPENROUTER_DEBUG=1
# OPENROUTER_DEBUG_DIR=./.openrouter-debug
